# -*-mode:gitconfig-*- vim:ft=gitconfig.gotexttmpl

[include]
  path = config.user
  path = conf.d/alias.conf
  path = conf.d/security.conf

[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red
  new = green

[init]
	defaultBranch = main

[format]
  pretty = format:%C(blue)%ad%C(reset) %C(yellow)%h%C(green)%d%C(reset) %C(blue)%s %C(magenta) [%an]%C(reset)

[branch]
  autosetuprebase = always

[http]
  version = HTTP/1.1
  postBuffer = 524288000

[remote]
  pushDefault = origin

[fetch]
  prune = true

[merge]
  branchdesc = true
  log = true

[push]
  default = current

[pull]
    rebase = true
[rebase]
    autoStash = true
{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{.UserName}}@{{.HostName}} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "foreground": "#82B1FF",
          "template": "\u250f\u2500 "
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{.Icon}}",
          "foreground": "#82B1FF",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \ue719 ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#689f63",
          "type": "node",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue627 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b0",
          "background": "#00acd7",
          "type": "go",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue624 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b0",
          "background": "#4063D8",
          "type": "julia",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_version": true,
            "fetch_virtual_env": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} \ue235 ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b0",
          "background": "#FFDE57",
          "type": "python",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_version": true
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue791 ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#AE1401",
          "type": "ruby",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_version": false
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uf0e7",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#FEAC19",
          "type": "azfunc",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_default": false
          },
          "template": " {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} \ue7ad ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#FFA400{{end}}",
            "{{if contains \"jan\" .Profile}}#f1184c{{end}}"
          ],
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .WorkspaceName }}{{ if .Version }} {{ .Version }}{{ end }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#4f34eb",
          "type": "terraform",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue81d {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#ebcc34",
          "type": "kubectl",
          "style": "powerline",
          "invert_powerline": false
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue77f {{ .Full }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#00ffff",
          "type": "dotnet",
          "style": "powerline",
          "invert_powerline": false
        }
      ],
      "newline": false
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "foreground": "#82B1FF",
          "template": "\u2523\u2500"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_host": true
          },
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#82B1FF",
          "type": "session",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "\uf115",
            "folder_separator_icon": " \ue0b1 ",
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} ",
          "foreground": "#e4e4e4",
          "powerline_symbol": "\ue0b0",
          "background": "#3465a4",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\uf126 ",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .HEAD }} {{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0}}\uf692 {{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0}} \uf1bb {{ .WorktreeCount }}{{ end }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#4e9a06",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#c4a000{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f26d50{{ end }}",
            "{{ if gt .Ahead 0 }}#4e9a06{{ end }}",
            "{{ if gt .Behind 0 }}#89d1dc{{ end }}"
          ]
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "background": "#f1fa8c",
          "foreground": "#00040e",
          "leading_diamond": "\ue0b6",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": "\udb80\udd09 {{ .CurrentDate | date .Format }} \u2022",
          "type": "time"
        },
        {
          "background": "#f1fa8c",
          "foreground": "#00040e",
          "options": {
            "always_enabled": true,
            "style": "austin",
            "threshold": 500
          },
          "style": "diamond",
          "template": " \ueba2 {{ .FormattedMs }}",
          "trailing_diamond": "\ue0b4",
          "type": "executiontime"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "display_exit_code": true
          },
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Meaning }}{{ else }}✔{{ end }} ",
          "foreground": "#d3d7cf",
          "powerline_symbol": "\ue0b2",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}#cc2222{{ end }}"
          ],
          "invert_powerline": false
        }
      ],
      "newline": false
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "foreground": "#82B1FF",
          "template": "\u2514\u2500"
        },
        {
          "type": "text",
          "style": "diamond",
          "foreground": "#82B1FF",
          "template": "{{ if .Env.DEVBOX_SHELL_ENABLED }}(devbox){{ end }}"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "foreground": "#82B1FF",
          "type": "shell",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "❯",
          "foreground": "#82B1FF",
          "type": "text",
          "style": "diamond"
        }
      ],
      "newline": true
    }
  ],
  "enable_cursor_positioning": true,
  "final_space": true,
  "patch_pwsh_bleed": true,
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#eae7de",
    "template": "    \u276f "
  },
  "shell_integration": true,
  "upgrade": {
    "auto": true,
    "interval": "168h",
    "notice": true,
    "source": "cdn"
  },
  "version": 3
}